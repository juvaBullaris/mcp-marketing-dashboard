# Copy to .env and fill in. Never commit .env.

# --- Google Analytics 4 ---
# Path to a service-account key (recommended on a server) or ADC file.
GOOGLE_APPLICATION_CREDENTIALS=./secrets/ga-service-account.json
GOOGLE_PROJECT_ID=your-gcp-project-id
GA4_PROPERTY_ID=123456789

# --- Meta Ads ---
# Long-lived System User token with ads_read permission.
META_ACCESS_TOKEN=EAAB...
META_AD_ACCOUNT_ID=act_1234567890

# --- Storage ---
DB_PATH=./data/marketing.db
